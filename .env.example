# Copy to .env.local and fill in. Next.js auto-loads .env.local; the
# one-off scripts/ files load it by hand (see scripts/run-sql.mjs).

# --- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=   # used by scripts/run-sql.mjs to apply migrations directly

# --- Shared-password auth (required) ----------------------------------------
SITE_PASSWORD=
SESSION_SECRET=

# --- Snowflake (NOT required — see PRICE_CLIPS.md) ---------------------------
# Decision 2026-11-06: no service account for this app. Price Clips' data-pull
# step is Claude+Tensor (ask Claude, upload the JSON it returns), by design,
# not as a stopgap. These vars only matter if that ever changes — they'd
# power the "Find Game" button's direct Snowflake lookup, which exists and is
# verified correct but isn't the supported path.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY=       # PEM, with \n escaped on one line
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_DATABASE=

# --- Vercel Sandbox (Price Clips rendering) ----------------------------------
# Not needed when deployed on Vercel (OIDC auth is automatic). Needed for
# local dev only, to run `npm run dev` and actually exercise the render API.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
